{
	"$schema": "https://unpkg.com/knip@latest/schema.json",
	"ignore": [
		"**/__tests__/**",
		".trunk/**",
		"apps/vscode-e2e/**",
		"src/extension/api.ts",
		"src/activate/**",
		"src/workers/countTokens.ts",
		"src/extension.ts",
		"scripts/**",
		"apps/cli/scripts/**",
		"apps/web-roo-code/next-sitemap.config.cjs",
		"check_page*.js",
		"check_syntax*.js",
		"data/cache/**",
		"playwright.config.ts"
	],
	"workspaces": {
		"src": {
			"entry": ["extension.ts"],
			"project": ["**/*.ts"]
		},
		"webview-ui": {
			"entry": ["src/index.tsx"],
			"project": ["src/**/*.{ts,tsx}", "../src/shared/*.ts"]
		},
		"packages/build": {
			"entry": ["src/index.ts"],
			"project": ["src/**/*.ts"]
		},
		"packages/{cloud,evals,ipc,telemetry,types}": {
			"project": ["src/**/*.ts"]
		}
	}
}
