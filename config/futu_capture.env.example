# Futu portfolio capture

# Vision model for screenshot parsing (requires OPENAI_API_KEY or OPENCLAW_API_KEY)
# FUTU_CAPTURE_VISION_MODEL=gpt-4o
# FUTU_CAPTURE_MAX_BYTES=10485760

# Discord outbound (holdings + AI advisory summary)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Discord bot inbound — optional channel filter (name substring or channel ID)
# Post a Futu screenshot in this channel, or use /portfolio-futu-capture
# DISCORD_FUTU_CAPTURE_CHANNEL=futu-portfolio
