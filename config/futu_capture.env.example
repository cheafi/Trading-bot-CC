# Futu portfolio capture

# Vision model for screenshot parsing (requires OPENAI_API_KEY, OPENCLAW_API_KEY, or Azure OpenAI)
# FUTU_CAPTURE_VISION_MODEL=gpt-4o
# FUTU_CAPTURE_MAX_BYTES=10485760

# Azure OpenAI (opt-in — set AZURE_OPENAI_ENABLED=true in main .env)
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2026-01-15-preview
# AZURE_OPENAI_API_KEY=...
# Or service principal: AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET

# Discord outbound (holdings + AI advisory summary)
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Discord bot inbound — optional channel filter (name substring or channel ID)
# Post a Futu screenshot in this channel, or use /portfolio-futu-capture
# DISCORD_FUTU_CAPTURE_CHANNEL=futu-portfolio
