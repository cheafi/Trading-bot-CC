# Discord real-life notices (pick one mode)
# Recommended — channel webhook (no bot permissions):
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Bot + explicit channel ID:
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_ID=

# Bot + channel name (auto-resolved on first ping; cached in data/artifacts/discord_channel_id.json):
# DISCORD_BOT_TOKEN=
# DISCORD_CHANNEL_NAME=Trading CC

# Optional toggles
# DISCORD_NOTIFY_ENABLED=true
# DISCORD_NOTIFY_RESEARCH=false
# DISCORD_ALERT_COOLDOWN_SEC=300
