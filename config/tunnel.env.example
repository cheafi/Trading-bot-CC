# CC public tunnel — copy to config/tunnel.env (gitignored via .env.*) or add to .env
# See docs/CC_X_PRODUCTION_READINESS.md

# Which provider: auto | cloudflare | ngrok
TUNNEL_PROVIDER=auto

# CC listen port on the host (must match docker-compose / _cc_instant.py)
CC_TUNNEL_PORT=8000

# ── Cloudflare Tunnel (preferred) ─────────────────────────────────────────────
# Quick tunnel (no token): random *.trycloudflare.com URL each run — fine for dev.
# Named tunnel (persistent URL): create at https://one.dash.cloudflare.com → Zero Trust → Networks → Tunnels
# CLOUDFLARE_TUNNEL_TOKEN=

# ── ngrok (alternative) ───────────────────────────────────────────────────────
# Sign up: https://dashboard.ngrok.com/get-started/your-authtoken
# NGROK_AUTHTOKEN=
# Optional reserved domain (paid plan):
# NGROK_DOMAIN=my-cc.ngrok-free.app

# ── API auth when exposing publicly ───────────────────────────────────────────
# Do NOT use dev-secret-local on the public internet. Generate a random key:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# API_SECRET_KEY=

# Optional: allow browser calls from the tunnel origin (only needed for split-origin setups)
# CORS_ORIGINS=https://your-subdomain.trycloudflare.com
