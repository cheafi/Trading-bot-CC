# Telegram immediate opportunity alerts — copy to .env or source alongside docker-compose
# See docs/TELEGRAM_SETUP.md

# Required: create bot via @BotFather, then send /start to your bot and read chat id
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789

# Optional CC deep links in alert messages (tunnel or LAN URL)
# CC_PUBLIC_BASE_URL=https://your-subdomain.trycloudflare.com
# CC_BASE_URL=http://localhost:8000

# Alert toggles
# TELEGRAM_NOTIFY_ENABLED=true
# TELEGRAM_NOTIFY_DEPLOY=true
# TELEGRAM_NOTIFY_MONITOR=true

# Dedup / rate limit (same ticker+tier within window)
# TELEGRAM_ALERT_DEDUPE=true
# TELEGRAM_ALERT_COOLDOWN_SEC=300

# Persist scan state for upgrade detection (data/artifacts/telegram_opportunity_state.json)
# TELEGRAM_OPPORTUNITY_STATE=true
