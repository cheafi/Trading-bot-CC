# CC Live Intelligence — Telegram immediate opportunity alerts
# Copy values to .env · full guide: docs/TELEGRAM_SETUP.md
# Bot: @TradingAI_AlertsCC_bot

# Required — @BotFather /newbot, then /start your bot and read chat id from getUpdates
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# TELEGRAM_CHAT_ID=123456789

# CC deep links in live alerts (tunnel or LAN URL)
# CC_PUBLIC_BASE_URL=https://your-subdomain.trycloudflare.com
# CC_BASE_URL=http://localhost:8000

# Alert toggles — DEPLOY = TRADE-bar qualified; MONITOR = research-only WATCH
# TELEGRAM_NOTIFY_ENABLED=true
# TELEGRAM_NOTIFY_DEPLOY=true
# TELEGRAM_NOTIFY_MONITOR=true

# Dedup — suppress repeat alerts for same ticker+tier within window (seconds)
# TELEGRAM_ALERT_DEDUPE=true
# TELEGRAM_ALERT_COOLDOWN_SEC=300

# Persist scan state for upgrade detection (data/artifacts/telegram_opportunity_state.json)
# TELEGRAM_OPPORTUNITY_STATE=true
