# Docker Model Runner (Docker Desktop) — optional local LLM for CC API
# Pull models: docker model pull ai/gemma3n:latest
# List models: docker model ls
# Docs: https://docs.docker.com/ai/model-runner/
#
# Merge into .env or docker-compose.dev.yml environment (do not commit secrets).

# auto = probe model-runner; on = require local; off = cloud/API only
LOCAL_LLM_ENABLED=auto

# OpenAI-compatible base URL (inside cc_api_dev container)
# LOCAL_LLM_URL=http://model-runner.docker.internal/engines/llama.cpp/v1

# Role-specific tags (see src/services/ai_service.py)
# LOCAL_MODEL_ADVISOR=ai/gemma3
# LOCAL_MODEL_REVIEWER=ai/qwen3-coder
# LOCAL_MODEL_EMBED=ai/all-minilm-l6-v2-vllm

# Legacy compose aliases (docker-compose.dev.yml)
# LOCAL_MODEL_FAST=ai/gemma3n:latest
# LOCAL_MODEL_HEAVY=ai/llama3.3:latest

# MCP: CC API docker stack has no MCP sidecar. MCP tooling lives in the
# VS Code / Cursor extension layer (src/services/mcp/). Use host MCP servers
# from the IDE, not from cc_api_dev.
