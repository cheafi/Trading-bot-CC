# TradingAI Bot — environment template (copy to .env; never commit secrets)

# ── Azure OpenAI (preferred when endpoint + auth configured) ────────────────
# Auto-activates when endpoint, deployment, and API key (or service principal) are set.
# Set AZURE_OPENAI_ENABLED=false to disable even when credentials exist.
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2026-01-15-preview
AZURE_OPENAI_API_KEY=

# Service principal auth (production; omit AZURE_OPENAI_API_KEY when using SP)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Per-task deployment overrides (optional)
# AZURE_OPENAI_DEPLOYMENT_NARRATIVE=gpt-4o
# AZURE_OPENAI_DEPLOYMENT_SIGNAL=gpt-4o
# AZURE_OPENAI_DEPLOYMENT_QUICK=gpt-4o-mini

# ── OpenAI direct API (fallback when Azure not configured) ───────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_MINI=gpt-4o-mini

# ── Optional Azure AI Search (knowledge/lessons enrichment) ──────────────────
AZURE_SEARCH_ENDPOINT=https://YOUR-SEARCH.search.windows.net
AZURE_SEARCH_INDEX=cc-lessons
AZURE_SEARCH_KEY=

# ── Local LLM (Docker Model Runner) ───────────────────────────────────────────
LOCAL_LLM_URL=http://localhost:12434/engines/llama.cpp/v1
LOCAL_LLM_ENABLED=auto

# ── AI governance ─────────────────────────────────────────────────────────────
# All LLM output is research_only — never grants deploy_open.
AI_DISABLED=false

# ── Unattended Docker trading (docker-compose.yml) ───────────────────────────
POSTGRES_PASSWORD=change-me
TWS_USERID=
TWS_PASSWORD=
TRADING_MODE=paper
# Live gate (fail-closed): LIVE_TRADING=1 + IB_MODE=live + IB_API_PORT=4003
LIVE_TRADING=0
IB_MODE=paper
IB_API_PORT=4002
HEARTBEAT_URL=
FUTU_OPEND_HOST_PATH=./docker/futu-opend
