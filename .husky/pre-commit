branch="$(git rev-parse --abbrev-ref HEAD)"

if [ "$branch" = "main" ]; then
  echo "You can't commit directly to main - please check out a branch."
  exit 1
fi

if [ "$OS" = "Windows_NT" ]; then
  pnpm_cmd="pnpm.cmd"
else
  if command -v pnpm >/dev/null 2>&1; then
    pnpm_cmd="pnpm"
  else
    pnpm_cmd="npx pnpm"
  fi
fi

# lint-staged@16 hangs on Node 22 during ESM bootstrap; mirror package.json lint-staged config.
if [ -x "./node_modules/.bin/prettier" ]; then
  staged_prettier="$(git diff --cached --name-only --diff-filter=ACMR | grep -E '\.(js|jsx|ts|tsx|json|css|md)$' || true)"
  if [ -n "$staged_prettier" ]; then
    echo "$staged_prettier" | tr '\n' '\0' | xargs -0 ./node_modules/.bin/prettier --write
    echo "$staged_prettier" | tr '\n' '\0' | xargs -0 git add
  fi
fi

